# ===== Live Chat Client - Environment Variables =====
# Copy this file to .env and fill in your values.
# On Railway, set these in the frontend service's "Variables" tab.

# Base URL of the backend API.
# - In DEVELOPMENT: leave empty (Vite proxy handles /api and /socket.io).
# - In PRODUCTION (separate frontend service): set to your backend URL,
#   e.g. https://your-backend.up.railway.app
# - In PRODUCTION (single service, frontend served by backend): leave empty
#   so requests use the same origin.
VITE_API_URL=
