# ===== Live Chat Server - Environment Variables =====
# Copy this file to .env and fill in your values.
# On Railway, set these in the service's "Variables" tab.

# Port the server listens on. Railway sets PORT automatically.
PORT=5000

# Environment: "production" or "development"
NODE_ENV=production

# Admin credentials for the admin panel login.
# CHANGE THESE from the defaults before deploying!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# JWT secret used to sign admin tokens.
# Use a long random string (e.g. 64+ chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# Allowed client origin for CORS.
# In production on Railway, set this to your frontend URL (e.g. https://your-app.up.railway.app).
# If the frontend is served from the same origin, you can leave this empty.
CLIENT_URL=

# Path to the JSON database file.
# On Railway, use a mounted volume path so data persists across deploys.
DB_PATH=./data/chat.json

# ===== AI (Google Gemini) Settings =====
# Get your API key from: https://aistudio.google.com/app/apikey
# If not set, AI features are disabled and only human admin replies.
GEMINI_API_KEY=your_key_here

# Gemini model to use (gemini-1.5-flash is free tier)
GEMINI_MODEL=gemini-1.5-flash

# AI mode: "hybrid" | "ai" | "human"
# - hybrid: AI replies automatically, admin can take over
# - ai: AI replies to everything
# - human: only admin replies (AI disabled)
AI_MODE=hybrid

# Max tokens for AI response
AI_MAX_TOKENS=500

# Temperature (0.0 = precise, 1.0 = creative)
AI_TEMPERATURE=0.7

# Rate limit: max AI requests per minute (Gemini free tier = 15)
AI_RATE_LIMIT=15
